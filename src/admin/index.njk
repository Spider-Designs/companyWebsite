---
title: Content Manager
sitemap: false
---
<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
    <title>
      {{ title }}
    </title>
  </head>
  <body>
    <!-- Include the script that builds the page and powers Decap CMS -->
    <script src="https://unpkg.com/decap-cms@^3.0.0/dist/decap-cms.js"></script>
    <script>
      const createPreviewElement = window.h;
      const createPreviewClass = window.createClass;

      function resolveAsset(getAsset, assetPath) {
        if (!assetPath) {
          return '';
        }

        const resolvedAsset = getAsset(assetPath);
        if (!resolvedAsset) {
          return assetPath;
        }

        if (typeof resolvedAsset === 'string') {
          return resolvedAsset;
        }

        if (typeof resolvedAsset.toString === 'function') {
          return resolvedAsset.toString();
        }

        return assetPath;
      }

      function formatDate(value) {
        if (!value) {
          return '';
        }

        const date = new Date(value);
        if (Number.isNaN(date.getTime())) {
          return value;
        }

        return new Intl.DateTimeFormat('en-GB', {
          day: 'numeric',
          month: 'short',
          year: 'numeric',
        }).format(date);
      }

      function buildPostPreview() {
        return createPreviewClass({
          render: function() {
            const props = this.props;
            const entry = props.entry;
            const data = entry.get('data');
            const title = data.get('title') || 'Untitled';
            const previewTitle = data.get('previewTitle') || title;
            const previewSummary = data.get('previewSummary') || '';
            const previewImage = resolveAsset(props.getAsset, data.get('previewImage'));
            const previewImageAlt = data.get('previewImageAlt') || previewTitle;
            const publishedDate = formatDate(data.get('date'));
            const tags = data.get('tags');
            const body = props.widgetFor('body');

            const visibleTags = tags && typeof tags.filter === 'function'
              ? tags.filter(function (tag) {
                  return tag && tag !== 'posts';
                }).toArray()
              : [];

            return createPreviewElement(
              'article',
              { className: 'decap-preview decap-preview--post' },
              createPreviewElement(
                'section',
                { className: 'decap-preview__listing' },
                createPreviewElement('p', { className: 'decap-preview__listing-label' }, 'Preview card elsewhere on the site'),
                createPreviewElement(
                  'article',
                  { className: 'blog-preview-card decap-preview-card-sample' },
                  createPreviewElement(
                    'div',
                    { className: 'blog-preview-card__link' },
                    previewImage
                      ? createPreviewElement(
                          'div',
                          { className: 'blog-preview-card__media' },
                          createPreviewElement('img', {
                            src: previewImage,
                            alt: previewImageAlt,
                          })
                        )
                      : null,
                    createPreviewElement(
                      'div',
                      { className: 'blog-preview-card__body' },
                      createPreviewElement(
                        'div',
                        { className: 'blog-preview-card__content' },
                        createPreviewElement('h3', null, previewTitle),
                        previewSummary
                          ? createPreviewElement('p', null, previewSummary)
                          : createPreviewElement('p', { className: 'decap-preview__muted' }, 'No preview summary added yet.')
                      ),
                      createPreviewElement(
                        'div',
                        { className: 'blog-preview-card__meta-row' },
                        publishedDate ? createPreviewElement('p', { className: 'blog-preview-card__meta' }, publishedDate) : null
                      )
                    )
                  )
                )
              ),
              createPreviewElement(
                'article',
                { className: 'post' },
                createPreviewElement(
                  'header',
                  { className: 'post-hero' },
                  createPreviewElement(
                    'div',
                    { className: 'wrapper post-hero__inner' },
                    publishedDate
                      ? createPreviewElement(
                          'p',
                          { className: 'post-hero__meta' },
                          createPreviewElement('span', null, 'Published'),
                          createPreviewElement('time', { dateTime: data.get('date') || '' }, publishedDate)
                        )
                      : null,
                    createPreviewElement('h1', null, title),
                    previewSummary ? createPreviewElement('p', { className: 'post-hero__summary' }, previewSummary) : null
                  )
                ),
                previewImage
                  ? createPreviewElement(
                      'section',
                      { className: 'post-featured' },
                      createPreviewElement(
                        'div',
                        { className: 'wrapper post-featured__inner' },
                        createPreviewElement('img', {
                          src: previewImage,
                          alt: previewImageAlt,
                        })
                      )
                    )
                  : null,
                createPreviewElement(
                  'section',
                  { className: 'post-content' },
                  createPreviewElement(
                    'div',
                    { className: 'wrapper post-content__inner prose' },
                    body
                  )
                ),
                createPreviewElement(
                  'footer',
                  { className: 'post-footer' },
                  createPreviewElement(
                    'div',
                    { className: 'wrapper post-footer__inner' },
                    visibleTags.length
                      ? createPreviewElement(
                          'ul',
                          { className: 'post-footer__tags' },
                          visibleTags.map(function (tag, index) {
                            return createPreviewElement('li', { key: 'tag-' + index }, tag);
                          })
                        )
                      : null
                  )
                )
              )
            );
          }
        });
      }

      function buildCaseStudyPreview() {
        return createPreviewClass({
          render: function() {
            const props = this.props;
            const entry = props.entry;
            const data = entry.get('data');
            const title = data.get('title') || 'Untitled';
            const subHeading = data.get('subHeading') || '';
            const client = data.get('client') || title;
            const location = data.get('location') || 'Location';
            const impact = data.get('impact') || '';
            const previewImage = resolveAsset(props.getAsset, data.get('previewImage'));
            const previewImageAlt = data.get('previewImageAlt') || client;
            const heroImage = resolveAsset(props.getAsset, data.get('heroImage'));
            const heroImageAlt = data.get('heroImageAlt') || title;
            const midHeroImage = resolveAsset(props.getAsset, data.get('midHeroImage'));
            const midHeroImageAlt = data.get('midHeroImageAlt') || '';
            const quote = data.get('quote') || '';
            const quoteAuthor = data.get('quoteAuthor') || '';
            const galleryImages = data.get('galleryImages');
            const quoteImages = data.get('quoteImages');
            const brief = props.widgetFor('brief');
            const approach = props.widgetFor('approach');
            const results = props.widgetFor('results');

            function renderImageList(items, className) {
              if (!items || !items.size) {
                return null;
              }

              return createPreviewElement(
                'section',
                { className: className },
                createPreviewElement(
                  'div',
                  { className: 'wrapper' },
                  createPreviewElement(
                    'div',
                    { className: 'cs-gallery__grid' },
                    items.map(function (item, index) {
                      const image = resolveAsset(props.getAsset, item.get('image'));
                      const alt = item.get('alt') || '';

                      if (!image) {
                        return null;
                      }

                      return createPreviewElement(
                        'div',
                        { className: 'cs-gallery__item', key: className + '-' + index },
                        createPreviewElement('img', {
                          src: image,
                          alt: alt,
                        })
                      );
                    }).toArray()
                  )
                )
              );
            }

            function renderSection(sectionClassName, label, body) {
              if (!body) {
                return null;
              }

              return createPreviewElement(
                'section',
                { className: 'cs-section ' + sectionClassName },
                createPreviewElement(
                  'div',
                  { className: 'wrapper cs-section__inner' },
                  createPreviewElement('h2', { className: 'cs-section__label heading' }, label),
                  createPreviewElement('div', { className: 'cs-section__body prose' }, body)
                )
              );
            }

            return createPreviewElement(
              'article',
              { className: 'decap-preview decap-preview--case-study' },
              createPreviewElement(
                'section',
                { className: 'decap-preview__listing' },
                createPreviewElement('p', { className: 'decap-preview__listing-label' }, 'Preview card elsewhere on the site'),
                createPreviewElement(
                  'article',
                  { className: 'case-study-preview-card decap-preview-card-sample' },
                  createPreviewElement(
                    'div',
                    { className: 'case-study-preview-card__link' },
                    previewImage
                      ? createPreviewElement(
                          'div',
                          { className: 'case-study-preview-card__media' },
                          createPreviewElement('img', {
                            src: previewImage,
                            alt: previewImageAlt,
                          })
                        )
                      : null,
                    createPreviewElement(
                      'div',
                      { className: 'case-study-preview-card__body' },
                      createPreviewElement('p', { className: 'case-study-preview-card__meta' }, client),
                      createPreviewElement('p', { className: 'case-study-preview-card__meta-secondary' }, location + (impact ? ' — ' + impact : ''))
                    )
                  )
                )
              ),
              createPreviewElement(
                'section',
                { className: 'cs-hero' },
                createPreviewElement(
                  'div',
                  { className: 'cs-hero__content' },
                  createPreviewElement('h1', { className: 'heading cs-hero__title' }, title),
                  createPreviewElement('p', { className: 'cs-hero__eyebrow' }, subHeading)
                )
              ),
              heroImage
                ? createPreviewElement(
                    'div',
                    { className: 'cs-hero__media' },
                    createPreviewElement('img', {
                      src: heroImage,
                      alt: heroImageAlt,
                    })
                  )
                : null,
              renderSection('cs-brief', 'Brief', brief),
              renderImageList(galleryImages, 'cs-gallery cs-gallery--pair'),
              renderSection('cs-approach', 'Approach', approach),
              midHeroImage
                ? createPreviewElement(
                    'section',
                    { className: 'cs-mid-hero' },
                    createPreviewElement('img', {
                      src: midHeroImage,
                      alt: midHeroImageAlt,
                    })
                  )
                : null,
              renderImageList(quoteImages, 'cs-gallery cs-gallery--group'),
              renderSection('cs-results', 'Results', results),
              quote
                ? createPreviewElement(
                    'section',
                    { className: 'cs-quote' },
                    createPreviewElement(
                      'div',
                      { className: 'wrapper' },
                      createPreviewElement(
                        'blockquote',
                        { className: 'cs-quote__block' },
                        createPreviewElement('p', { className: 'cs-quote__text' }, '“' + quote + '”'),
                        quoteAuthor ? createPreviewElement('cite', { className: 'cs-quote__cite' }, '— ' + quoteAuthor) : null
                      )
                    )
                  )
                : null,
              createPreviewElement(
                'section',
                { className: 'cs-more' },
                createPreviewElement(
                  'div',
                  { className: 'wrapper' },
                  createPreviewElement('h2', { className: 'cs-more__heading' }, 'More Case Studies'),
                  createPreviewElement(
                    'div',
                    { className: 'case-study-preview-grid' },
                    createPreviewElement(
                      'article',
                      { className: 'case-study-preview-card' },
                      createPreviewElement(
                        'div',
                        { className: 'case-study-preview-card__link' },
                        previewImage
                          ? createPreviewElement(
                              'div',
                              { className: 'case-study-preview-card__media' },
                              createPreviewElement('img', {
                                src: previewImage,
                                alt: previewImageAlt,
                              })
                            )
                          : null,
                        createPreviewElement(
                          'div',
                          { className: 'case-study-preview-card__body' },
                          createPreviewElement('p', { className: 'case-study-preview-card__meta' }, client),
                          createPreviewElement('p', { className: 'case-study-preview-card__meta-secondary' }, location + (impact ? ' — ' + impact : ''))
                        )
                      )
                    )
                  )
                )
              )
            );
          }
        });
      }

      window.CMS.registerPreviewStyle('/css/admin-preview.css');
      window.CMS.registerPreviewTemplate('blog', buildPostPreview());
      window.CMS.registerPreviewTemplate('case-studies', buildCaseStudyPreview());
    </script>
  </body>
</html>
